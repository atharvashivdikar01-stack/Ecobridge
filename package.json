{
  "name": "ecobridge",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "build:portal": "pnpm --filter @ecobridge/recycler-portal build",
    "build:admin": "pnpm --filter @ecobridge/admin-dashboard build",
    "dev:portal": "pnpm --filter @ecobridge/recycler-portal dev",
    "dev:admin": "pnpm --filter @ecobridge/admin-dashboard dev",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
