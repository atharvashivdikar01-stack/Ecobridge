# Copy to .env for local development. Do not commit the copied file.
DATABASE_URL=postgresql://ecobridge:replace-with-local-password@localhost:5432/ecobridge
SECRET_KEY=replace-with-a-long-random-development-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=5
CORS_ORIGINS=["http://localhost:3001"]
