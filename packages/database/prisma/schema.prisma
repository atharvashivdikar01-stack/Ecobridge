// ECOBRIDGE Prisma Schema
// Database: PostgreSQL 16 with PostGIS extension

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis(version: "3.4"), uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// --------------------------------------------------------
// ENUMS
// --------------------------------------------------------

enum UserRole {
  COLLECTOR
  RECYCLER_OPERATOR
  RECYCLER_ADMIN
  PLATFORM_ADMIN
  AUDITOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
  INACTIVE
}

enum CollectorType {
  INDIVIDUAL_PICKER
  KABADIWALA
  SCRAP_AGGREGATOR
  COMMUNITY_ENTERPRISE
}

enum PermitType {
  HAZARDOUS_WASTE_AUTHORIZATION
  E_WASTE_DISMANTLER
  E_WASTE_RECYCLER
  PRO_PRODUCER_RESPONSIBILITY_ORG
  REFURBISHER
}

enum PermitStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING_RENEWAL
  SUSPENDED
}

enum HazardSeverity {
  INFO
  WARNING
  DANGER
  CRITICAL
}

enum HazardCondition {
  NORMAL
  SWOLLEN_BATTERY
  LEAKING_ELECTROLYTE
  BROKEN_CRT_GLASS
  BURNT_COMPONENTS
  MERCURY_CONTAINING
  CORRODED_TERMINALS
}

enum LotStatus {
  DRAFT
  PENDING_SYNC
  COLLECTED
  OFFERED
  ACCEPTED
  IN_TRANSIT
  DELIVERED
  VERIFIED
  SETTLED
  CANCELLED
  DISPUTED
}

enum OfferType {
  DIRECT_BUYOUT
  BID
  SCHEDULED_PICKUP
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  COUNTERED
}

enum HandoverType {
  COLLECTOR_TO_TRANSPORTER
  COLLECTOR_TO_FACILITY
  TRANSPORTER_TO_FACILITY
}

enum HandoverStatus {
  PENDING
  COMPLETED
  DISPUTED
  REJECTED
}

enum CustodyEventType {
  CREATION
  HAZARD_FLAGGED
  OFFER_ACCEPTED
  HANDOVER_INITIATED
  FACILITY_INTAKE
  WEIGHBRIDGE_CONFIRMED
  MATERIAL_SORTED
  PAYMENT_DISBURSED
  DISMANTLED
  RECYCLED
  EPR_CERTIFICATE_ISSUED
}

enum TransactionType {
  ESCROW_LOCK
  ESCROW_RELEASE
  COLLECTOR_PAYOUT
  PLATFORM_FEE
  RECYCLER_REFUND
}

enum TransactionStatus {
  PENDING
  HELD_IN_ESCROW
  SETTLED
  FAILED
  REFUNDED
}

enum EscrowStatus {
  ACTIVE
  RELEASED
  FORFEITED
  DISPUTED
}

enum PayoutMethod {
  UPI
  IMPS
  BANK_TRANSFER
  CASH_VOUCHER
}

enum PayoutStatus {
  INITIATED
  PROCESSING
  SUCCESS
  FAILURE
  REVERSED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  OVERRIDE
  LOGIN
  PERMISSION_CHANGE
}

// --------------------------------------------------------
// MODELS: IDENTITY & USERS
// --------------------------------------------------------

model User {
  id                String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone             String       @unique @db.VarChar(20)
  fullName          String       @map("full_name") @db.VarChar(255)
  email             String?      @unique @db.VarChar(255)
  passwordHash      String?      @map("password_hash") @db.VarChar(255)
  role              UserRole     @default(COLLECTOR)
  status            UserStatus   @default(ACTIVE)
  preferredLanguage String       @default("en") @map("preferred_language") @db.VarChar(10)
  avatarUrl         String?      @map("avatar_url") @db.Text
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  collectorProfile  CollectorProfile?
  recyclerCompany   RecyclerCompany?
  custodyEvents     CustodyEvent[]
  sentTransactions  Transaction[]     @relation("SenderTransactions")
  receivedTx        Transaction[]     @relation("RecipientTransactions")
  auditLogs         AuditLog[]

  @@map("users")
}

model CollectorProfile {
  id                   String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String        @unique @map("user_id") @db.Uuid
  collectorType        CollectorType @default(INDIVIDUAL_PICKER) @map("collector_type")
  nationalIdNumber     String?       @map("national_id_number") @db.VarChar(100)
  nationalIdType       String?       @map("national_id_type") @db.VarChar(50) // e.g. AADHAAR, VOTER_ID
  bankAccountNumber    String?       @map("bank_account_number") @db.VarChar(50)
  ifscCode             String?       @map("ifsc_code") @db.VarChar(20)
  upiId                String?       @map("upi_id") @db.VarChar(100)
  trustScore           Decimal       @default(1.00) @map("trust_score") @db.Decimal(5, 2)
  totalLotsCollected   Int           @default(0) @map("total_lots_collected")
  totalWeightKg        Decimal       @default(0.000) @map("total_weight_kg") @db.Decimal(12, 3)
  verifiedAt           DateTime?     @map("verified_at") @db.Timestamptz(6)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lots                 Lot[]
  payouts              PaymentPayout[]

  @@map("collector_profiles")
}

// --------------------------------------------------------
// MODELS: RECYCLERS & AUTHORIZATIONS
// --------------------------------------------------------

model RecyclerCompany {
  id                   String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId               String              @unique @map("user_id") @db.Uuid
  companyName          String              @map("company_name") @db.VarChar(255)
  tradeLicenseNumber   String              @unique @map("trade_license_number") @db.VarChar(100)
  gstNumber            String?             @unique @map("gst_number") @db.VarChar(50)
  cpcbRegistrationNo   String              @unique @map("cpcb_registration_no") @db.VarChar(100)
  contactPerson        String              @map("contact_person") @db.VarChar(100)
  contactPhone         String              @map("contact_phone") @db.VarChar(20)
  contactEmail         String?             @map("contact_email") @db.VarChar(255)
  operatingStatus      UserStatus          @default(PENDING_VERIFICATION) @map("operating_status")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilities           RecyclerFacility[]
  offers               LotOffer[]
  escrowHolds          EscrowHold[]
  eprCertificates      EPRCertificate[]

  @@map("recycler_companies")
}

model RecyclerFacility {
  id                    String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  recyclerId            String                @map("recycler_id") @db.Uuid
  facilityName          String                @map("facility_name") @db.VarChar(255)
  addressLine1          String                @map("address_line1") @db.VarChar(255)
  addressLine2          String?               @map("address_line2") @db.VarChar(255)
  city                  String                @db.VarChar(100)
  state                 String                @db.VarChar(100)
  postalCode            String                @map("postal_code") @db.VarChar(20)
  latitude              Decimal               @db.Decimal(10, 8)
  longitude             Decimal               @db.Decimal(11, 8)
  location              Unsupported("geography(Point, 4326)")
  dailyCapacityKg       Decimal               @default(0.00) @map("daily_capacity_kg") @db.Decimal(10, 2)
  acceptsHazardous      Boolean               @default(false) @map("accepts_hazardous")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  company               RecyclerCompany       @relation(fields: [recyclerId], references: [id], onDelete: Cascade)
  authorizations        AuthorizationRecord[]
  assignedLots          Lot[]
  handovers             Handover[]
  offers                LotOffer[]

  @@index([recyclerId])
  @@map("recycler_facilities")
}

model AuthorizationRecord {
  id               String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  facilityId       String           @map("facility_id") @db.Uuid
  authorityName    String           @map("authority_name") @db.VarChar(100) // e.g. CPCB, SPCB
  permitType       PermitType       @map("permit_type")
  permitNumber     String           @unique @map("permit_number") @db.VarChar(100)
  issuedDate       DateTime         @map("issued_date") @db.Date
  expiryDate       DateTime         @map("expiry_date") @db.Date
  status           PermitStatus     @default(ACTIVE)
  documentUrl      String?          @map("document_url") @db.Text
  verifiedAt       DateTime?        @map("verified_at") @db.Timestamptz(6)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  facility         RecyclerFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@index([expiryDate])
  @@map("authorization_records")
}

// --------------------------------------------------------
// MODELS: WASTE TAXONOMY, MATERIALS & SAFETY GUIDANCE
// --------------------------------------------------------

model WasteCategory {
  id             String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code           String         @unique @db.VarChar(50) // e.g. CAT_ITEW, CAT_CEEW, CAT_BATT
  name           String         @db.VarChar(150)
  description    String?        @db.Text
  defaultHazard  HazardSeverity @default(INFO) @map("default_hazard")
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  materials      Material[]

  @@map("waste_categories")
}

model Material {
  id                   String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  categoryId           String              @map("category_id") @db.Uuid
  code                 String              @unique @db.VarChar(100) // e.g. PCB_GRADE_A, LI_ION_POUCH
  name                 String              @db.VarChar(200)
  description          String?             @db.Text
  baseUnit             String              @default("KG") @map("base_unit") @db.VarChar(20)
  standardYieldJson    Json?               @map("standard_yield_json") // e.g. {"Cu": 0.20, "Au_ppm": 250}
  requiresPermit       Boolean             @default(false) @map("requires_permit")
  isActive             Boolean             @default(true) @map("is_active")
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  category             WasteCategory       @relation(fields: [categoryId], references: [id])
  safetyGuidances      SafetyGuidance[]
  priceBands           MaterialPriceBand[]
  lotItems             LotItem[]

  @@index([categoryId])
  @@map("materials")
}

model SafetyGuidance {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  materialId            String?         @map("material_id") @db.Uuid
  hazardCondition       HazardCondition @default(NORMAL) @map("hazard_condition")
  severity              HazardSeverity  @default(INFO)
  titleKey              String          @map("title_key") @db.VarChar(100)
  messageKey            String          @map("message_key") @db.VarChar(255)
  requiredPpeJson       Json            @map("required_ppe_json") // e.g. ["HEAVY_GLOVES", "SAFETY_GOGGLES"]
  prohibitedActionsJson Json            @map("prohibited_actions_json") // e.g. ["NO_OPEN_BURNING", "DO_NOT_CRUSH"]
  emergencyProtocolKey  String?         @map("emergency_protocol_key") @db.VarChar(100)
  audioPromptKey        String?         @map("audio_prompt_key") @db.VarChar(100)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  material              Material?       @relation(fields: [materialId], references: [id], onDelete: Cascade)
  lotItems              LotItem[]

  @@index([materialId])
  @@index([hazardCondition])
  @@map("safety_guidance")
}

// --------------------------------------------------------
// MODELS: PRICING & COMMODITY INDICES
// --------------------------------------------------------

model CommodityPriceIndex {
  id                 String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  commoditySymbol    String    @map("commodity_symbol") @db.VarChar(20) // e.g. CU, AU, AG, AL, LI
  exchangeSource     String    @map("exchange_source") @db.VarChar(50)  // e.g. LME, MCX, DOMESTIC
  currency           String    @default("INR") @db.VarChar(10)
  spotPrice          Decimal   @map("spot_price") @db.Decimal(14, 4)
  unit               String    @default("KG") @db.VarChar(20)
  effectiveTimestamp DateTime  @map("effective_timestamp") @db.Timestamptz(6)
  recordedAt         DateTime  @default(now()) @map("recorded_at") @db.Timestamptz(6)

  @@index([commoditySymbol, effectiveTimestamp(sort: Desc)])
  @@map("commodity_price_indices")
}

model MaterialPriceBand {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  materialId           String    @map("material_id") @db.Uuid
  grade                String    @default("STANDARD") @db.VarChar(50) // e.g. GRADE_A, GRADE_B
  minPricePerUnit      Decimal   @map("min_price_per_unit") @db.Decimal(12, 2)
  maxPricePerUnit      Decimal   @map("max_price_per_unit") @db.Decimal(12, 2)
  benchmarkPricePerUnit Decimal   @map("benchmark_price_per_unit") @db.Decimal(12, 2)
  currency             String    @default("INR") @db.VarChar(10)
  effectiveFrom        DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo          DateTime? @map("effective_to") @db.Timestamptz(6)
  isActive             Boolean   @default(true) @map("is_active")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  material             Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId, isActive])
  @@map("material_price_bands")
}

// --------------------------------------------------------
// MODELS: LOTS, ITEMS & IMAGES
// --------------------------------------------------------

model Lot {
  id                      String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lotCode                 String            @unique @map("lot_code") @db.VarChar(50)
  collectorId             String            @map("collector_id") @db.Uuid
  designatedFacilityId    String?           @map("designated_facility_id") @db.Uuid
  status                  LotStatus         @default(COLLECTED)
  totalEstimatedWeightKg  Decimal           @default(0.000) @map("total_estimated_weight_kg") @db.Decimal(12, 3)
  totalVerifiedWeightKg   Decimal?          @map("total_verified_weight_kg") @db.Decimal(12, 3)
  estimatedValue          Decimal           @default(0.00) @map("estimated_value") @db.Decimal(12, 2)
  finalValue              Decimal?          @map("final_value") @db.Decimal(12, 2)
  currency                String            @default("INR") @db.VarChar(10)
  originLatitude          Decimal?          @map("origin_latitude") @db.Decimal(10, 8)
  originLongitude         Decimal?          @map("origin_longitude") @db.Decimal(11, 8)
  originLocation          Unsupported("geography(Point, 4326)")?
  originAddress           String?           @map("origin_address") @db.Text
  offlineCreatedAt        DateTime          @map("offline_created_at") @db.Timestamptz(6)
  syncedAt                DateTime?         @map("synced_at") @db.Timestamptz(6)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  collector               CollectorProfile  @relation(fields: [collectorId], references: [id])
  designatedFacility      RecyclerFacility? @relation(fields: [designatedFacilityId], references: [id])
  items                   LotItem[]
  images                  LotImage[]
  offers                  LotOffer[]
  handovers               Handover[]
  custodyEvents           CustodyEvent[]
  transactions            Transaction[]
  eprCertificates         EPRCertificate[]

  @@index([collectorId])
  @@index([status])
  @@index([createdAt])
  @@map("lots")
}

model LotItem {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lotId                 String          @map("lot_id") @db.Uuid
  materialId            String          @map("material_id") @db.Uuid
  quantity              Int             @default(1)
  unit                  String          @default("KG") @db.VarChar(20)
  estimatedWeightKg     Decimal         @map("estimated_weight_kg") @db.Decimal(12, 3)
  verifiedWeightKg      Decimal?        @map("verified_weight_kg") @db.Decimal(12, 3)
  aiConfidenceScore     Decimal?        @map("ai_confidence_score") @db.Decimal(5, 4)
  detectedHazard        HazardCondition @default(NORMAL) @map("detected_hazard")
  safetyGuidanceId      String?         @map("safety_guidance_id") @db.Uuid
  unitPriceEstimated    Decimal         @map("unit_price_estimated") @db.Decimal(12, 2)
  unitPriceVerified     Decimal?        @map("unit_price_verified") @db.Decimal(12, 2)
  subtotalEstimated     Decimal         @map("subtotal_estimated") @db.Decimal(12, 2)
  subtotalFinal         Decimal?        @map("subtotal_final") @db.Decimal(12, 2)
  notes                 String?         @db.Text
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relationships
  lot                   Lot             @relation(fields: [lotId], references: [id], onDelete: Cascade)
  material              Material        @relation(fields: [materialId], references: [id])
  safetyGuidance        SafetyGuidance? @relation(fields: [safetyGuidanceId], references: [id])
  images                LotImage[]

  @@index([lotId])
  @@index([materialId])
  @@map("lot_items")
}

model LotImage {
  id                    String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lotId                 String          @map("lot_id") @db.Uuid
  lotItemId             String?         @map("lot_item_id") @db.Uuid
  imageUrl              String          @map("image_url") @db.Text
  imageHash             String          @map("image_hash") @db.VarChar(64) // SHA-256
  latitude              Decimal?        @db.Decimal(10, 8)
  longitude             Decimal?        @db.Decimal(11, 8)
  capturedAt            DateTime        @map("captured_at") @db.Timestamptz(6)
  isProofOfCollection   Boolean         @default(false) @map("is_proof_of_collection")
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  lot                   Lot             @relation(fields: [lotId], references: [id], onDelete: Cascade)
  lotItem               LotItem?        @relation(fields: [lotItemId], references: [id], onDelete: SetNull)

  @@index([lotId])
  @@index([imageHash])
  @@map("lot_images")
}

// --------------------------------------------------------
// MODELS: OFFERS & HANDOVERS
// --------------------------------------------------------

model LotOffer {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lotId                String           @map("lot_id") @db.Uuid
  recyclerId           String           @map("recycler_id") @db.Uuid
  facilityId           String?          @map("facility_id") @db.Uuid
  offerType            OfferType        @default(DIRECT_BUYOUT) @map("offer_type")
  offeredTotalPrice    Decimal          @map("offered_total_price") @db.Decimal(12, 2)
  pickupCostDeduction  Decimal          @default(0.00) @map("pickup_cost_deduction") @db.Decimal(12, 2)
  netCollectorEarning  Decimal          @map("net_collector_earning") @db.Decimal(12, 2)
  currency             String           @default("INR") @db.VarChar(10)
  breakdownJson        Json?            @map("breakdown_json")
  status               OfferStatus      @default(OFFERED)
  expiresAt            DateTime         @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  respondedAt          DateTime?        @map("responded_at") @db.Timestamptz(6)

  // Relationships
  lot                  Lot              @relation(fields: [lotId], references: [id], onDelete: Cascade)
  recycler             RecyclerCompany  @relation(fields: [recyclerId], references: [id])
  facility             RecyclerFacility? @relation(fields: [facilityId], references: [id])

  @@index([lotId])
  @@index([recyclerId])
  @@index([status])
  @@map("lot_offers")
}

model Handover {
  id                    String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lotId                 String            @map("lot_id") @db.Uuid
  facilityId            String?           @map("facility_id") @db.Uuid
  handoverType          HandoverType      @map("handover_type")
  sourceActorId         String            @map("source_actor_id") @db.Uuid
  destinationActorId    String            @map("destination_actor_id") @db.Uuid
  handoverTimestamp     DateTime          @default(now()) @map("handover_timestamp") @db.Timestamptz(6)
  latitude              Decimal?          @db.Decimal(10, 8)
  longitude             Decimal?          @db.Decimal(11, 8)
  location              Unsupported("geography(Point, 4326)")?
  qrTokenScanned        String?           @map("qr_token_scanned") @db.VarChar(255)
  weighbridgeSlipNumber String?           @map("weighbridge_slip_number") @db.VarChar(100)
  weighbridgeGrossKg    Decimal?          @map("weighbridge_gross_kg") @db.Decimal(12, 3)
  weighbridgeTareKg     Decimal?          @map("weighbridge_tare_kg") @db.Decimal(12, 3)
  weighbridgeNetKg      Decimal?          @map("weighbridge_net_kg") @db.Decimal(12, 3)
  scaleCalibrationId    String?           @map("scale_calibration_id") @db.VarChar(100)
  signedManifestHash    String?           @map("signed_manifest_hash") @db.VarChar(64)
  status                HandoverStatus    @default(PENDING)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  lot                   Lot               @relation(fields: [lotId], references: [id], onDelete: Cascade)
  facility              RecyclerFacility? @relation(fields: [facilityId], references: [id])

  @@index([lotId])
  @@index([status])
  @@map("handovers")
}

// --------------------------------------------------------
// MODELS: TRACEABILITY & EPR COMPLIANCE
// --------------------------------------------------------

model CustodyEvent {
  id                 String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  lotId              String           @map("lot_id") @db.Uuid
  sequenceNumber     Int              @map("sequence_number")
  eventType          CustodyEventType @map("event_type")
  actorId            String           @map("actor_id") @db.Uuid
  actorRole          UserRole         @map("actor_role")
  latitude           Decimal?         @db.Decimal(10, 8)
  longitude          Decimal?         @db.Decimal(11, 8)
  location           Unsupported("geography(Point, 4326)")?
  eventTimestamp     DateTime         @default(now()) @map("event_timestamp") @db.Timestamptz(6)
  eventPayloadJson   Json             @map("event_payload_json")
  previousEventHash  String           @map("previous_event_hash") @db.VarChar(64)
  currentEventHash   String           @map("current_event_hash") @db.VarChar(64)
  digitalSignature   String?          @map("digital_signature") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  lot                Lot              @relation(fields: [lotId], references: [id], onDelete: Cascade)
  actor              User             @relation(fields: [actorId], references: [id])

  @@unique([lotId, sequenceNumber])
  @@index([lotId])
  @@index([currentEventHash])
  @@map("custody_events")
}

model EPRCertificate {
  id                  String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  certificateNumber   String           @unique @map("certificate_number") @db.VarChar(100)
  lotId               String           @map("lot_id") @db.Uuid
  recyclerId          String           @map("recycler_id") @db.Uuid
  totalWeightKg       Decimal          @map("total_weight_kg") @db.Decimal(12, 3)
  materialCategory    String           @map("material_category") @db.VarChar(100)
  destructionMethod   String           @map("destruction_method") @db.VarChar(150)
  certificateHash     String           @unique @map("certificate_hash") @db.VarChar(64)
  spcbFilingReference String?          @map("spcb_filing_reference") @db.VarChar(100)
  issuedAt            DateTime         @default(now()) @map("issued_at") @db.Timestamptz(6)

  // Relationships
  lot                 Lot              @relation(fields: [lotId], references: [id])
  recycler            RecyclerCompany  @relation(fields: [recyclerId], references: [id])

  @@index([recyclerId])
  @@index([lotId])
  @@map("epr_certificates")
}

// --------------------------------------------------------
// MODELS: TRANSACTIONS, ESCROW & PAYMENTS
// --------------------------------------------------------

model Transaction {
  id                 String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  referenceNumber    String            @unique @map("reference_number") @db.VarChar(100)
  transactionType    TransactionType   @map("transaction_type")
  lotId              String?           @map("lot_id") @db.Uuid
  senderUserId       String?           @map("sender_user_id") @db.Uuid
  recipientUserId    String?           @map("recipient_user_id") @db.Uuid
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("INR") @db.VarChar(10)
  status             TransactionStatus @default(PENDING)
  notes              String?           @db.Text
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt          DateTime?         @map("settled_at") @db.Timestamptz(6)

  // Relationships
  lot                Lot?              @relation(fields: [lotId], references: [id])
  senderUser         User?             @relation("SenderTransactions", fields: [senderUserId], references: [id])
  recipientUser      User?             @relation("RecipientTransactions", fields: [recipientUserId], references: [id])
  escrowHold         EscrowHold?
  paymentPayout      PaymentPayout?

  @@index([referenceNumber])
  @@index([lotId])
  @@index([status])
  @@map("transactions")
}

model EscrowHold {
  id                   String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  transactionId        String       @unique @map("transaction_id") @db.Uuid
  recyclerId           String       @map("recycler_id") @db.Uuid
  heldAmount           Decimal      @map("held_amount") @db.Decimal(12, 2)
  currency             String       @default("INR") @db.VarChar(10)
  status               EscrowStatus @default(ACTIVE)
  lockedAt             DateTime     @default(now()) @map("locked_at") @db.Timestamptz(6)
  releasedAt           DateTime?    @map("released_at") @db.Timestamptz(6)

  // Relationships
  transaction          Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  recycler             RecyclerCompany @relation(fields: [recyclerId], references: [id])

  @@index([recyclerId])
  @@index([status])
  @@map("escrow_holds")
}

model PaymentPayout {
  id                   String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  transactionId        String           @unique @map("transaction_id") @db.Uuid
  collectorId          String           @map("collector_id") @db.Uuid
  payoutMethod         PayoutMethod     @default(UPI) @map("payout_method")
  gatewayReference     String?          @unique @map("gateway_reference") @db.VarChar(150)
  gatewayResponseJson  Json?            @map("gateway_response_json")
  amount               Decimal          @db.Decimal(12, 2)
  currency             String           @default("INR") @db.VarChar(10)
  status               PayoutStatus     @default(INITIATED)
  initiatedAt          DateTime         @default(now()) @map("initiated_at") @db.Timestamptz(6)
  completedAt          DateTime?        @map("completed_at") @db.Timestamptz(6)

  // Relationships
  transaction          Transaction      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  collector            CollectorProfile @relation(fields: [collectorId], references: [id])

  @@index([collectorId])
  @@index([status])
  @@map("payment_payouts")
}

// --------------------------------------------------------
// MODELS: SYSTEM AUDIT & SECURITY LOGS
// --------------------------------------------------------

model AuditLog {
  id             BigInt       @id @default(autoincrement())
  entityName     String       @map("entity_name") @db.VarChar(100)
  entityId       String       @map("entity_id") @db.VarChar(100)
  action         AuditAction
  actorId        String?      @map("actor_id") @db.Uuid
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  userAgent      String?      @map("user_agent") @db.Text
  beforeState    Json?        @map("before_state")
  afterState     Json?        @map("after_state")
  reason         String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  // Relationships
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityName, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}
