<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Application Theme (Material Design, NoActionBar for custom AppBars) -->
    <style name="Theme.EcoBridge" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary Colors -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Background & Surface -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface_container_lowest</item>

        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/primary</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColorSecondary">@color/on_surface_variant</item>
    </style>

    <!-- Splash Theme -->
    <style name="Theme.EcoBridge.Splash" parent="Theme.EcoBridge">
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/primary</item>
    </style>

    <!-- High-Contrast Large Button Style -->
    <style name="Widget.EcoBridge.LargeButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">12dp</item>
        <item name="elevation">3dp</item>
    </style>

    <!-- Sunlight Outdoor Tactile Card Style -->
    <style name="Widget.EcoBridge.ActionCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/surface_container_lowest</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.EcoBridge.ActionCard.Active" parent="Widget.EcoBridge.ActionCard">
        <item name="cardBackgroundColor">@color/primary</item>
        <item name="strokeColor">@color/primary_fixed</item>
        <item name="strokeWidth">2dp</item>
    </style>

    <style name="Widget.EcoBridge.ActionCard.Offline" parent="Widget.EcoBridge.ActionCard">
        <item name="cardBackgroundColor">#FFF8F0</item>
        <item name="strokeColor">@color/secondary</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

</resources>
